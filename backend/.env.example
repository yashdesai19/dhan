# ==============================================================================
# Environment Configuration for DHAN Backend
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dhan-insecure-development-secret-key-change-in-production-1234567890

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dhan_user
POSTGRES_PASSWORD=dhan_password
POSTGRES_DB=dhan_db

# Connection URLs
# FastAPI uses asyncpg for async SQLAlchemy operations
DATABASE_URL=postgresql+asyncpg://dhan_user:dhan_password@localhost:5432/dhan_db
# Alembic and sync tools use psycopg
SYNC_DATABASE_URL=postgresql+psycopg://dhan_user:dhan_password@localhost:5432/dhan_db

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_CORS_ORIGINS=["*"]

# Django Admin Configuration
DJANGO_SECRET_KEY=dhan-django-insecure-secret-key-change-in-production-abcdef
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_PORT=8002

# ==============================================================================
# Production (ENVIRONMENT=production): the API and admin refuse to start unless
#   DEBUG=False, DJANGO_DEBUG=False
#   JWT_SECRET_KEY / SECRET_KEY: unique random values, 32+ characters
#   DJANGO_SECRET_KEY: unique random value, 50+ characters
#   FASTAPI_CORS_ORIGINS: the exact web origins allowed (no "*")
#   DJANGO_ALLOWED_HOSTS: the admin host names (no "*")
#   DJANGO_CSRF_TRUSTED_ORIGINS: e.g. https://admin.example.com
#   POSTGRES_PASSWORD / DATABASE_URL: not the development password
# Optional: RATE_LIMIT_ENABLED=True (default), DJANGO_HSTS_PRELOAD=False (default)
# ==============================================================================
